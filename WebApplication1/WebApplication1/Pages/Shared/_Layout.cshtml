<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0c0c24, #1a1a3a, #0b0f1c);
            color: white;
            font-family: 'Orbitron', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: rgba(0, 0, 10, 0.9);
            border-bottom: 2px solid #00ffff;
            padding: 12px 0;
            box-shadow: 0 0 15px #00bfff;
            width: 100%;
            text-align: center;
            z-index: 1000;
        }

        .nav-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            list-style: none;
            padding: 0;
            margin: 0;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
        }

            .nav-links a {
                color: #00ffff;
                text-decoration: none;
                text-shadow: 0 0 8px #00ffff;
                transition: all 0.3s;
            }

                .nav-links a:hover {
                    color: #ffffff;
                    text-shadow: 0 0 12px #00ffff, 0 0 20px #00bfff;
                }

        .container {
            flex: 1;
            padding: 20px 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            width: 100%;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <ul class="nav-links">
            <li><a href="/">Мемасики</a></li>
            <li><a href="/Translate"> 翻译成中文</a></li>
        </ul>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>